# LGX/Pandora 88M80 WiFi dongle modeswitch
# Triggers when device appears in CD-ROM mode (1111:1111).
# Uses systemd device integration so the service runs after local-fs.target
# (when /var/usrlocal is mounted). RUN+= fires too early — /usr/local is a
# symlink into /var which isn't mounted yet at udev time on Bazzite.
#
# 1111:1111 is a fake/unassigned VID shared by many OEM devices.
# ATTRS{vendor} and ATTRS{model} match the SCSI INQUIRY response strings
# (LGX / WIFI6) to uniquely identify this dongle among other 1111:1111 devices.
# ATTRS{manufacturer} and ATTRS{product} are the USB string descriptors
# (AIC / 88M80) as a second layer of confirmation.
# Note: the device presents SCSI peripheral type 0x00 (Direct-Access), not
# CD-ROM (0x05), despite appearing as a virtual storage device.
ACTION=="add", SUBSYSTEM=="block", KERNEL=="sd[a-z]", \
    ATTRS{idVendor}=="1111", ATTRS{idProduct}=="1111", \
    ATTRS{vendor}=="LGX*", ATTRS{model}=="WIFI6*", \
    ATTRS{manufacturer}=="AIC", ATTRS{product}=="88M80", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}="88m80-modeswitch@%k.service", \
    RUN+="/bin/sh -c 'test -x /usr/local/bin/88m80-modeswitch && exec /usr/local/bin/88m80-modeswitch /dev/%k || true'"
